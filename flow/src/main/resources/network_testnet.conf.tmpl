alephium {
  # Alephium's blockchain is sharded into `groups` groups and `groups * groups` chains.
  # A clique is one full copy of that chain set. Production nodes (especially mainnet)
  # must use a single broker: broker-num = 1. Splitting a clique across multiple brokers
  # is an unfinished scaling prototype and is not supported in production.
  broker {
    # The id of the broker in the clique. Must be 0 when broker-num is 1.
    broker-id = 0

    # The number of brokers in the clique. Must be 1 on mainnet.
    broker-num = 1

    # The number of groups, which is a consensus constant of the network, and should not be changed.
    # Testnet and Mainnet may use different values though
    groups = 4
  }

  consensus {
    mainnet {
      block-target-time = 64 seconds
      uncle-dependency-gap-time = 16 seconds
    }
    rhone {
      block-target-time = 16 seconds
      uncle-dependency-gap-time = 8 seconds
    }
    danube {
      block-target-time = 8 seconds
      uncle-dependency-gap-time = 4 seconds
    }
    num-zeros-at-least-in-hash = 19
  }

  network {
    no-pre-mine-proof = [
      "0000000000000000000a4f99913767b9c730d9ce77b2d3238a4d7d169a2fd637", # BTC 703674 block hash
      "9cbbf357f1bc2fd0f3e605748d862f3cdb25d6fe778e17f33e0d42e78a067d52"  # ETH 13359221 block hash
    ]

    leman-hard-fork-timestamp = 1676210400000 // GMT: Sun Feb 12 2023 14:00:00
    rhone-hard-fork-timestamp = 1715428800000 // GMT: Sat May 11 2024 12:00:00
    danube-hard-fork-timestamp = 1746446400000 // GMT: Mon May 05 2025 12:00:00
  }

  discovery {
    bootstrap = []
  }

  genesis {
    allocations = [
      {
        address = "15y5UYQbTbeDHx9YtCHaKH95uEji2S3vTRyoeo9hsuC1",
        amount = "1700000000000000000000000",
        lock-duration = 0 seconds
      },
      {
        address = "1HGuyxRvZxVDZ55fmwMWMnGi2Te6wc3DjSVrTjqFztPJi",
        amount = "1000000000000000000000000",
        lock-duration = 0 seconds
      },
      {
        address = "1AB8iVqmcxmyktMwivt4tsp1bAHmtabE3T6wYAifZoTJr",
        amount = "1000000000000000000000000",
        lock-duration = 0 seconds
      },
      {
        address = "13mCVJT2nwBCNpzgdT85YCo4pqfkQw1NXQLXWY3fqk7AJ",
